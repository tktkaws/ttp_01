---
import Sun from "@lucide/astro/icons/sun";
import Moon from "@lucide/astro/icons/moon";
import Monitor from "@lucide/astro/icons/monitor";

const sections = [
  { id: "section01", label: "私について" },
  { id: "section02", label: "略歴" },
  { id: "section03", label: "業務経歴" },
  { id: "section04", label: "アクセシビリティへの関心" },
  { id: "section05", label: "知的好奇心" },
  { id: "section06", label: "アウトプット" },
];
---

<nav class="mobile-nav" id="mobile-nav" aria-label="セクションナビゲーション">
  <button
    type="button"
    class="mobile-nav__trigger"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label="ナビゲーションを開く"
  >
    <span class="mobile-nav__trigger-text">メニュー</span>
  </button>
  <div class="mobile-nav__menu">
    <ul class="mobile-nav__links" role="menu">
      {sections.map(({ id, label }) => (
        <li role="menuitem">
          <a href={`#${id}`} class="mobile-nav__link" data-section={id}>
            {label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mobile-nav__theme">
      <button type="button" class="mobile-nav__theme-option" data-theme="light">
        <Sun size={16} />
        <span>ライト</span>
      </button>
      <button type="button" class="mobile-nav__theme-option" data-theme="dark">
        <Moon size={16} />
        <span>ダーク</span>
      </button>
      <button type="button" class="mobile-nav__theme-option" data-theme="system">
        <Monitor size={16} />
        <span>システム</span>
      </button>
    </div>
  </div>
</nav>

<style>
  .mobile-nav {
    position: fixed;
    bottom: calc(var(--spacing) * 2);
    right: calc(var(--spacing) * 2);
    z-index: 50;
  }

  @media (min-width: 640px) {
    .mobile-nav {
      bottom: calc(var(--spacing) * 4);
      right: calc(var(--spacing) * 4);
    }
  }

  @media (min-width: 768px) {
    .mobile-nav {
      display: none;
    }
  }

  .mobile-nav__trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background: #fff;
    cursor: pointer;
    font-size: 0.875rem;
    color: inherit;
  }

  :global(.dark) .mobile-nav__trigger {
    border-color: #4b5563;
    background: #1f2937;
  }

  .mobile-nav__menu {
    display: none;
    position: absolute;
    bottom: 100%;
    right: 0;
    margin-bottom: 0.5rem;
    padding: 0.25rem;
    border-radius: 0.5rem;
    border: 1px solid #d1d5db;
    background: #fff;
    min-width: 12rem;
  }

  :global(.dark) .mobile-nav__menu {
    border-color: #4b5563;
    background: #1f2937;
  }

  .mobile-nav__menu.is-open {
    display: block;
  }

  .mobile-nav__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mobile-nav__link {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    color: inherit;
    text-decoration: none;
  }

  .mobile-nav__link:hover,
  .mobile-nav__link:focus-visible {
    background: #f3f4f6;
  }

  :global(.dark) .mobile-nav__link:hover,
  :global(.dark) .mobile-nav__link:focus-visible {
    background: #374151;
  }

  .mobile-nav__link.is-active {
    font-weight: 700;
  }

  .mobile-nav__theme {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.25rem;
    margin-top: 0.75rem;
  }

  .mobile-nav__theme-option {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    border: none;
    border-radius: 0.375rem;
    background: transparent;
    cursor: pointer;
    font-size: 0.75rem;
    color: inherit;
  }

  .mobile-nav__theme-option:hover,
  .mobile-nav__theme-option:focus-visible {
    background: #f3f4f6;
  }

  :global(.dark) .mobile-nav__theme-option:hover,
  :global(.dark) .mobile-nav__theme-option:focus-visible {
    background: #374151;
  }

  .mobile-nav__theme-option[aria-checked="true"] {
    font-weight: 700;
  }
</style>

<script>
  const nav = document.getElementById("mobile-nav")!;
  const trigger = nav.querySelector<HTMLButtonElement>(".mobile-nav__trigger")!;
  const triggerText = nav.querySelector<HTMLSpanElement>(".mobile-nav__trigger-text")!;
  const menu = nav.querySelector(".mobile-nav__menu")!;
  const links = nav.querySelectorAll<HTMLAnchorElement>(".mobile-nav__link");
  const themeOptions = nav.querySelectorAll<HTMLButtonElement>(".mobile-nav__theme-option");

  // Toggle menu
  trigger.addEventListener("click", () => {
    const isOpen = menu.classList.toggle("is-open");
    trigger.setAttribute("aria-expanded", String(isOpen));
    triggerText.textContent = isOpen ? "閉じる" : "メニュー";
  });

  function closeMenu() {
    menu.classList.remove("is-open");
    trigger.setAttribute("aria-expanded", "false");
    triggerText.textContent = "メニュー";
  }

  // Close on link click
  links.forEach((link) => {
    link.addEventListener("click", () => closeMenu());
  });

  // Close on outside click
  document.addEventListener("click", (e) => {
    if (!nav.contains(e.target as Node)) {
      closeMenu();
    }
  });

  // Theme toggle
  function getStoredTheme(): string {
    return localStorage.getItem("theme") || "system";
  }

  function getSystemTheme(): string {
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  function applyTheme(theme: string) {
    const resolved = theme === "system" ? getSystemTheme() : theme;
    document.documentElement.classList.toggle("dark", resolved === "dark");

    themeOptions.forEach((opt) => {
      opt.setAttribute("aria-checked", opt.dataset.theme === theme ? "true" : "false");
    });

    // Sync desktop ThemeToggle if present
    const desktopOptions = document.querySelectorAll<HTMLButtonElement>(
      "#theme-toggle .theme-toggle__option"
    );
    desktopOptions.forEach((opt) => {
      opt.setAttribute("aria-checked", opt.dataset.theme === theme ? "true" : "false");
    });
  }

  function setTheme(theme: string) {
    localStorage.setItem("theme", theme);
    applyTheme(theme);
  }

  themeOptions.forEach((opt) => {
    opt.addEventListener("click", () => {
      setTheme(opt.dataset.theme!);
    });
  });

  // Init theme state
  applyTheme(getStoredTheme());

  // Intersection Observer for current section
  const sectionIds = Array.from(links).map((link) => link.dataset.section!);
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  let currentSection = sectionIds[0];

  function updateActive(id: string) {
    currentSection = id;
    links.forEach((link) => {
      link.classList.toggle("is-active", link.dataset.section === id);
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          updateActive(entry.target.id);
        }
      });
    },
    {
      rootMargin: "-20% 0px -60% 0px",
    }
  );

  sections.forEach((section) => observer.observe(section));

  // Init
  updateActive(currentSection);
</script>
